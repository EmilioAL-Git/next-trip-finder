FLIGHT_PROVIDER=google

# Google Flights vía fast-flights (gratis, NO oficial, sin API key).
# Ver README para el aviso legal/de fiabilidad antes de usarlo en producción.
GOOGLE_FLIGHTS_MAX_TOTAL_SEARCHES=40
GOOGLE_FLIGHTS_MAX_CONCURRENCY=5
GOOGLE_FLIGHTS_PROXY=
GOOGLE_FLIGHTS_TOP_OPTIONS_PER_LEG=5

# Duffel (self-service oficial, de pago en modo live): https://app.duffel.com/join
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2
DUFFEL_MAX_TOTAL_SEARCHES=40

# Kiwi Tequila (invite-only partner access, alternativa opcional: FLIGHT_PROVIDER=kiwi)
TEQUILA_API_KEY=
TEQUILA_BASE_URL=https://api.tequila.kiwi.com

DEFAULT_CURRENCY=EUR
ALLOWED_ORIGINS=http://localhost:8080
REQUEST_TIMEOUT_SECONDS=20
